# Relay device credentials. Copy this file to relay_credentials.yaml (gitignored,
# see .gitignore) and fill in real values. Never commit the real file.
#
# Provisioned out of band against a real relayly server (POST /api/v1/devices,
# or `relayly pair <name>`), not minted by anything in this repo. See
# gateway/docs/relay-transport.md's "Credentials" section for the full picture.
#
# Only read when gateway.yaml's transport: relay and the gateway was built
# with -DKARSHIPTA_GATEWAY_ENABLE_RELAY=ON.

device_id: gateway-1
device_token: ""
# Empty/omitted falls back to relayly's own default (~/.relayly/device.key).
private_key_path: ""
