{
	"name": "@nikx-tech/karshipta-console-core",
	"version": "0.16.0",
	"type": "module",
	"license": "AGPL-3.0-only",
	"description": "Karshipta console: fleet store, gateway transport, wire types, and the live-map UI. Reference app in src/routes; the publishable library is src/lib. Interim name: GitHub Packages requires the npm scope to match the repo owner (NIKX-Tech), a scope shared by every NIKX product, so the product name stays in the package name itself. Renames to @karshipta/console-core once a real karshipta npm org exists at OSS launch: a rename and republish, not a rebuild.",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./wire": {
			"types": "./dist/wire.d.ts",
			"default": "./dist/wire.js"
		},
		"./aircraft-proxy": {
			"types": "./dist/aircraft/adsbLolProxy.d.ts",
			"default": "./dist/aircraft/adsbLolProxy.js"
		},
		"./obstacles-proxy": {
			"types": "./dist/obstacles/openaipProxy.d.ts",
			"default": "./dist/obstacles/openaipProxy.js"
		},
		"./airports-proxy": {
			"types": "./dist/airports/openaipProxy.d.ts",
			"default": "./dist/airports/openaipProxy.js"
		},
		"./theme.css": "./dist/theme.css",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*"
	],
	"peerDependencies": {
		"svelte": "^5.0.0",
		"tailwindcss": "^4.0.0"
	},
	"publishConfig": {
		"access": "restricted",
		"directory": "dist",
		"registry": "https://npm.pkg.github.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/NIKX-Tech/karshipta.git",
		"directory": "console"
	},
	"scripts": {
		"predev": "node scripts/copy-maplibre-worker.mjs",
		"dev": "vite dev",
		"prebuild": "node scripts/copy-maplibre-worker.mjs",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"proto:gen": "buf generate",
		"package": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@bufbuild/buf": "^1.72.0",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26",
		"@types/supercluster": "^7.1.3",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"publint": "^0.3.24",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.0",
		"ts-proto": "^2.12.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0",
		"vite": "^8.2.2"
	},
	"dependencies": {
		"@bufbuild/protobuf": "^2.14.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/space-grotesk": "^5.3.0",
		"@mapbox/mapbox-gl-rtl-text": "^0.4.0",
		"@turf/boolean-point-in-polygon": "^7.4.0",
		"@turf/helpers": "^7.3.5",
		"maplibre-gl": "^6.6.0",
		"relayly": "0.6.0",
		"supercluster": "^9.0.0"
	}
}
